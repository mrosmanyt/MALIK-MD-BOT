# Required for pairing after first scan (optional if using QR)
# SESSION folder is used by default for multi-file auth

PREFIX=.
BOT_NAME=MALIK-MD
OWNER_NAME=MALIK
OWNER_NUMBER=923000000000
MODE=public
PORT=3000

# Optional MongoDB (sessions/config helpers)
MONGODB_URL=

# AI providers (at least one for AI commands)
OPENAI_API_KEY=
GROQ_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GROQ_MODEL=llama-3.3-70b-versatile

# Sticker pack meta
PACK_NAME=MALIK-MD
PACK_AUTHOR=MALIK

# Group features
ANTILINK=false
WELCOME=false

# Timezone for runtime display
TIME_ZONE=Asia/Karachi
