# Required for pairing after first scan (optional if using QR)
# SESSION folder is used by default for multi-file auth

PREFIX=.
BOT_NAME=MALIK-MD
OWNER_NAME=MALIK
OWNER_NUMBER=923489057646
MODE=public
PORT=3000

# Optional MongoDB (sessions/config helpers + admin users)
MONGODB_URL=

# AI providers (at least one for AI commands)
OPENAI_API_KEY=
GROQ_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GROQ_MODEL=llama-3.3-70b-versatile

# Sticker pack meta
PACK_NAME=MALIK-MD
PACK_AUTHOR=MALIK

# Group features
ANTILINK=false
WELCOME=false

# Timezone for runtime display
TIME_ZONE=Asia/Karachi

# Website admin panel (/admin) — credentials from env ONLY, never hardcode
ADMIN_EMAIL=mrosmanyt@gmail.com
ADMIN_PASSWORD=
# Optional long-lived API token (Bearer) / cookie signing override
ADMIN_TOKEN=

# WhatsApp worker (Baileys). On Vercel this defaults to off (admin panel only).
# On Heroku/local the bot starts unless you somehow set VERCEL.
# Set RUN_BOT=true only if you intentionally want Baileys on a long-lived host.
# RUN_BOT=true
